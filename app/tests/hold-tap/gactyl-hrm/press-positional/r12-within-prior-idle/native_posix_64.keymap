#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/* Timings as shipped in DactylZMKGur config/cosmos.keymap (200 ms term, 150 ms prior-idle,
   quick-tap off). pos0 = right-hand mod RGUI/N (triggers: left keys 2 3), pos1 = right key O,
   pos2 = left key W, pos3 = left-hand mod LALT/T (triggers: right keys 0 1). */
/ {
    behaviors {
        hmr: hrm_hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <2 3>;
            
            
        };
        hml: hrm_hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1>;
            
            
        };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &hmr RGUI N &kp O
                &kp W &hml LALT T>;
        };
    };
};

&kscan {
    events = <
        /* warm-up tap of a plain key so require-prior-idle starts from idle */
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,500)
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,100)
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_RELEASE(0,0,10)
    >;
};
